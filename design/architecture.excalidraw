  {
   "id": "e2",
   "type": "text",
   "x": 420,
   "y": 48,
   "width": 463.68000000000006,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 423938500,
   "version": 1,
   "versionNonce": 698935573,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1.0  NestJS webhook API + Flipkart poller (EventBridge)\n2.0  Reservation worker: one atomic UPDATE per SKU, all items or none\n3.0  Stock push workers: one pool per channel, rate-limited\n4.0  ERP worker: idempotent key, circuit breaker for Sunday downtime\n5.0  Ops API + React screen (inspect, retry, acknowledge)",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 12,
   "containerId": null,
   "originalText": "1.0  NestJS webhook API + Flipkart poller (EventBridge)\n2.0  Reservation worker: one atomic UPDATE per SKU, all items or none\n3.0  Stock push workers: one pool per channel, rate-limited\n4.0  ERP worker: idempotent key, circuit breaker for Sunday downtime\n5.0  Ops API + React screen (inspect, retry, acknowledge)",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
